# Binance Testnet API Credentials
# WICHTIG: Diese Datei kopieren als ".env" und mit echten Testnet-Keys füllen
# Testnet Keys erstellen auf: https://testnet.binance.vision/

BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_key_here

# Trading Bot Konfiguration
TRADING_MODE=HOLD  # VERKAUFEN, KAUFEN, oder HOLD
DRY_RUN=true       # true = keine echten Trades, nur Simulation
